{% extends 'base.html.twig' %}

{% block title %}Personal{% endblock %}

{% block body %}
    <h1>Personal</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ personal.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ personal.nombre }}</td>
            </tr>
            <tr>
                <th>Apellido</th>
                <td>{{ personal.apellido }}</td>
            </tr>
            <tr>
                <th>Dni</th>
                <td>{{ personal.dni }}</td>
            </tr>
            <tr>
                <th>Cargo</th>
                <td>{{ personal.cargo }}</td>
            </tr>
            <tr>
                <th>Activo</th>
                <td>{{ personal.activo ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Foto</th>
                <td>
                    <img src="{{ asset('img/personal/' ~ personal.id ~ '.jpg') }}"
                        alt="Foto de {{ personal.nombre }}"
                        style="max-width: 150px; height: auto; border: 1px solid #ccc; border-radius: 4px;">
                </td>
            </tr>
        
        </tbody>
    </table>

    <a href="{{ path('app_personal_index') }}">back to list</a>

    <a href="{{ path('app_personal_edit', {'id': personal.id}) }}">edit</a>

    {{ include('personal/_delete_form.html.twig') }}
{% endblock %}
